# Django Core
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Celery & Redis
CELERY_BROKER_URL=redis://redis:6379/0
