# ==============================================================================
# Git Ignore Configuration
# ==============================================================================

# Frontend Directory (Explicitly Excluded)
front/

# Python & Django Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
!.env.example

# Local Databases
*.sqlite3
*.db
db.sqlite3

# Celery & Background Process Artifacts
celerybeat-schedule
celerybeat-schedule.db
celerybeat-schedule.dir
celerybeat-schedule.bak
celerybeat.pid
*.pid

# Django Media & Collected Static Files
media/
staticfiles/
!staticfiles/.gitkeep
!media/.gitkeep

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test & Coverage Artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Logs
*.log
logs/

# IDE & Editor Configurations
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.project
.pydevproject
.settings/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Agent & AI Artifacts
.gemini/
